{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos",
  "version": "1.0.0",
  "identifier": "com.kilbertert.kairos",
  "build": {
    "frontendDist": "../../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairos 时流",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
